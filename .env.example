# Copiez ce fichier en `.env` puis renseignez les valeurs.
# `.env` est ignoré par git : ne mettez jamais de vraie valeur dans ce modèle.

# --- Base de données -------------------------------------------------------
# En local : un fichier SQLite. En production : libsql://<base>-<org>.turso.io
DATABASE_URL="file:./dev.db"
# Obligatoire pour Turso, inutile pour un fichier local.
DATABASE_AUTH_TOKEN=""

# --- Chiffrement AES-256-GCM -----------------------------------------------
# 64 caractères hexadécimaux : `npm run key:generate`
# Si cette clé est perdue ou changée, les données chiffrées sont illisibles.
ENCRYPTION_KEY=""

# --- Accès -----------------------------------------------------------------
# Email de l'unique administrateur : l'email principal et vérifié de son compte
# GitHub (ou de son compte Google).
ADMIN_EMAIL="admin@example.com"

# --- Better-Auth -----------------------------------------------------------
# Au moins 32 caractères : `npm run key:generate` (valeur différente de la clé
# de chiffrement).
BETTER_AUTH_SECRET=""
# URL publique de l'application, sans chemin.
BETTER_AUTH_URL="http://localhost:3000"

# --- OAuth : au moins un fournisseur ---------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optionnel
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
