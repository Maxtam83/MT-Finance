    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:deploy:turso:check": "node --env-file=.env.turso scripts/db-deploy.ts --dry-run",
    "db:deploy:turso": "node --env-file=.env.turso scripts/db-deploy.ts",
    "key:generate": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "1.7.28",
